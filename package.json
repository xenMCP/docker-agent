{
  "name": "xenmcp-docker-agent",
  "version": "1.0.1",
  "description": "Read-only MCP server for the containers on one Docker host: list, inspect, logs, stats and events. Nothing that starts, stops, removes or execs.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "e2e": "node test/e2e.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/server": "2.4.0",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xenMCP/docker-agent"
  },
  "homepage": "https://xenmcp.com"
}
